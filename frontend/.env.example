# Cấu hình dashboard. Sao chép thành .env.local để ghi đè khi phát triển.
# LƯU Ý: mọi biến VITE_* bị nhúng vào bundle trình duyệt — tuyệt đối không đặt secret ở đây.

# Base URL của API. Để trống = cùng origin (dev dùng proxy của Vite, production dùng reverse proxy nginx).
VITE_API_BASE_URL=
# Đường dẫn SignalR hub.
VITE_SIGNALR_HUB_PATH=/hubs/tasks
VITE_APP_NAME=DevAgent

# Chỉ dùng cho Vite dev server (không vào bundle).
DEV_PROXY_TARGET=http://localhost:5080
DEV_SERVER_PORT=5173
