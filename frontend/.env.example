# Dashboard configuration. Copy to .env.local to override during development.
# WARNING: every VITE_* variable is embedded in the browser bundle. Never put secrets here.

# API base URL. Empty means same origin (Vite proxy in dev, nginx reverse proxy in production).
VITE_API_BASE_URL=
# SignalR hub path.
VITE_SIGNALR_HUB_PATH=/hubs/tasks
VITE_APP_NAME=DevAgent

# Vite dev server only (not bundled).
DEV_PROXY_TARGET=http://localhost:5080
DEV_SERVER_PORT=5173
