# ============================================================================
# DevAgent environment variables for docker compose.
#   cp .env.example .env    (never commit .env)
# Secrets (passwords, API keys, tokens) belong in .env or a secret manager,
# never in appsettings*.json.
#
# Maps to .NET configuration as Section__Key (e.g. Ai__Anthropic__ApiKey); see docker-compose.yml.
# ============================================================================

# ---- Environment ----
# Development uses the fake AI/GitHub adapters. Every environment signs in with password accounts.
APP_ENVIRONMENT=Development
LOG_FORMAT=json                      # json | text

# ---- Public ports on the host ----
API_PORT=5080
WEB_PORT=8080
POSTGRES_PORT=5432
PUBLIC_DASHBOARD_URL=http://localhost:8080

# ---- PostgreSQL (state + durable queue) ----
POSTGRES_DB=devagent
POSTGRES_USER=devagent
POSTGRES_PASSWORD=change-me-local-only
APPLY_MIGRATIONS=true                # production: false, run a migration bundle instead

# ---- Authentication ----
AUTH_JWT_SIGNING_KEY=                # secret, at least 32 bytes, e.g. openssl rand -base64 48
AUTH_COOKIE_SECURE=false             # false for localhost over HTTP, true behind HTTPS
BOOTSTRAP_ADMIN_EMAIL=admin@devagent.local
BOOTSTRAP_ADMIN_PASSWORD=            # secret temporary password: 10+ chars with upper case, lower case and digits

# ---- AI provider ----
AI_PROVIDER=Fake                     # Fake | Anthropic
AI_DEFAULT_MODEL=claude-opus-5-5
AI_EFFORT=high                       # low | medium | high | xhigh | max
ANTHROPIC_API_KEY=                   # secret, required when AI_PROVIDER=Anthropic

# ---- GitHub App ----
GITHUB_MODE=Fake                     # Disabled | Fake | App
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=               # secret
GITHUB_PRIVATE_KEY_FILE=./secrets/github-app.pem   # host file mounted into the container as a secret
GITHUB_PRIVATE_KEY_PATH=/run/secrets/github-app.pem

# ---- Discord ----
DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=                   # secret
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_NOTIFICATION_CHANNEL_ID=

# ---- Security ----
# AES-256 key encrypting stored credentials. Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# ---- Limits ----
MAX_COST_USD_PER_TASK=2.00
TASK_TIMEOUT_MINUTES=60
MAX_CONCURRENT_TASKS=2
WORKER_MAX_CONCURRENT_JOBS=2
WORKER_REPLICAS=1

# ---- Observability ----
# Enable with docker compose --profile observability up -d, then set OTLP_ENDPOINT=http://otel-lgtm:4317
OTLP_ENDPOINT=
