# ============================================================================
# DevAgent — biến môi trường cho docker compose.
#   cp .env.example .env    (file .env KHÔNG được commit)
# Giá trị secret (mật khẩu, API key, token) chỉ đặt trong .env hoặc secret manager,
# không bao giờ đặt trong appsettings*.json.
#
# Ánh xạ sang cấu hình .NET: Section__Key (vd Ai__Anthropic__ApiKey) — xem docker-compose.yml.
# ============================================================================

# ---- Môi trường ----
# Development dùng AI/GitHub giả lập. Đăng nhập bằng tài khoản có mật khẩu ở mọi môi trường.
APP_ENVIRONMENT=Development
LOG_FORMAT=json                      # json | text

# ---- Cổng public trên máy host ----
API_PORT=5080
WEB_PORT=8080
POSTGRES_PORT=5432
PUBLIC_DASHBOARD_URL=http://localhost:8080

# ---- PostgreSQL (trạng thái + hàng đợi bền vững) ----
POSTGRES_DB=devagent
POSTGRES_USER=devagent
POSTGRES_PASSWORD=change-me-local-only
APPLY_MIGRATIONS=true                # production: false, chạy migration bundle riêng

# ---- Xác thực ----
AUTH_JWT_SIGNING_KEY=                # secret, tối thiểu 32 byte, ví dụ tạo bằng openssl rand -base64 48
AUTH_COOKIE_SECURE=false             # localhost HTTP dùng false, môi trường thật dùng HTTPS và true
BOOTSTRAP_ADMIN_EMAIL=admin@devagent.local
BOOTSTRAP_ADMIN_PASSWORD=            # secret, mật khẩu tạm ít nhất 10 ký tự gồm chữ hoa, chữ thường và số

# ---- Nhà cung cấp AI ----
AI_PROVIDER=Fake                     # Fake | Anthropic
AI_DEFAULT_MODEL=claude-opus-5-5
AI_EFFORT=high                       # low | medium | high | xhigh | max
ANTHROPIC_API_KEY=                   # secret, bắt buộc khi AI_PROVIDER=Anthropic

# ---- GitHub App ----
GITHUB_MODE=Fake                     # Disabled | Fake | App
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=               # secret
GITHUB_PRIVATE_KEY_FILE=./secrets/github-app.pem   # file trên host, mount vào container dạng secret
GITHUB_PRIVATE_KEY_PATH=/run/secrets/github-app.pem

# ---- Discord ----
DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=                   # secret
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_NOTIFICATION_CHANNEL_ID=

# ---- Bảo mật ----
# Khóa AES-256 mã hóa credential trong DB. Tạo: openssl rand -base64 32
ENCRYPTION_KEY=

# ---- Hạn mức (checklist 0.7) ----
MAX_COST_USD_PER_TASK=2.00
TASK_TIMEOUT_MINUTES=60
MAX_CONCURRENT_TASKS=2
WORKER_MAX_CONCURRENT_JOBS=2
WORKER_REPLICAS=1

# ---- Observability ----
# Bật: docker compose --profile observability up -d, rồi đặt OTLP_ENDPOINT=http://otel-lgtm:4317
OTLP_ENDPOINT=
