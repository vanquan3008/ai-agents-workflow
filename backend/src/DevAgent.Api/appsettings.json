{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Npgsql": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Database": {
    "CommandTimeoutSeconds": 30,
    "MaxRetryCount": 3,
    "ApplyMigrationsOnStartup": false,
    "EnableSensitiveDataLogging": false
  },
  "JobQueue": {
    "MaxAttempts": 5,
    "BaseRetryDelaySeconds": 10,
    "MaxRetryDelaySeconds": 600
  },
  "Auth": {
    "Jwt": {
      "Issuer": "devagent",
      "Audience": "devagent-api",
      "SigningKey": "",
      "AccessTokenMinutes": 15
    },
    "RefreshCookie": {
      "Name": "devagent_rt",
      "Secure": true
    },
    "Policy": {
      "PasswordMinLength": 10,
      "MaxFailedAttempts": 5,
      "LockoutMinutes": 15,
      "RefreshTokenDays": 7
    }
  },
  "Bootstrap": {
    "SuperAdmin": {
      "Email": "",
      "Password": "",
      "DisplayName": "Super Admin"
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "TaskCreationPerMinute": 10,
    "AuthPerMinute": 10
  },
  "PublicUrls": {
    "Dashboard": "https://devagent.example.com"
  },
  "AgentLimits": {
    "MaxCostUsdPerTask": 2.0,
    "MaxTokensPerTask": 2000000,
    "MaxModelCallsPerTask": 40,
    "MaxOutputTokensPerCall": 16000,
    "TaskTimeoutMinutes": 60,
    "MaxFixIterations": 3,
    "MaxRetries": 2,
    "MaxConcurrentTasks": 2,
    "ApprovalTtlHours": 72,
    "PlannerMaxFiles": 500
  },
  "Ai": {
    "Provider": "Anthropic",
    "DefaultModel": "claude-opus-5-5",
    "Models": {
      "planner": "claude-opus-5-5",
      "coding": "claude-opus-5-5",
      "reviewer": "claude-opus-5-5"
    },
    "Effort": "high",
    "RequestTimeoutSeconds": 600,
    "MaxRetries": 2,
    "Pricing": {
      "claude-opus-5-5": {
        "InputPerMillion": 4.0,
        "OutputPerMillion": 20.0,
        "CacheReadPerMillion": 0.2
      },
      "claude-sonnet-5-5": {
        "InputPerMillion": 2.0,
        "OutputPerMillion": 10.0,
        "CacheReadPerMillion": 0.1
      }
    },
    "Anthropic": {
      "ApiKey": "",
      "BaseUrl": "",
      "EnableServerSideFallback": true
    }
  },
  "GitHub": {
    "Mode": "Disabled",
    "AppId": null,
    "PrivateKeyPath": "",
    "WebhookSecret": "",
    "ApiBaseUrl": "https://api.github.com",
    "IssueTriggerLabel": "devagent",
    "InstallationTokenLifetimeSeconds": 3000
  },
  "Discord": {
    "Enabled": false,
    "BotToken": "",
    "ApplicationId": "",
    "GuildId": "",
    "NotificationChannelId": "",
    "ApiBaseUrl": "https://discord.com/api/v10"
  },
  "Sandbox": {
    "Enabled": false,
    "Image": "mcr.microsoft.com/dotnet/sdk:10.0",
    "CpuLimit": 2,
    "MemoryLimitMb": 4096,
    "CommandTimeoutSeconds": 600,
    "MaxLifetimeSeconds": 3600,
    "NetworkPolicy": "none",
    "AllowedHosts": [],
    "RunAsUserId": 10001
  },
  "Security": {
    "EncryptionKey": ""
  },
  "Observability": {
    "ServiceNamespace": "devagent",
    "OtlpEndpoint": "",
    "OtlpProtocol": "grpc",
    "ConsoleFormat": "json"
  }
}
