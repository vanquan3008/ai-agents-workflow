{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning"
    }
  },
  "Database": {
    "ApplyMigrationsOnStartup": true,
    "SeedDevelopmentData": false,
    "MaxRetryCount": 0
  },
  "Auth": {
    "Development": {
      "Enabled": true
    }
  },
