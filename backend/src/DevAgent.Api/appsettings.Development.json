{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System.Net.Http.HttpClient": "Warning",
        "Npgsql": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=devagent;Username=devagent;Password=devagent"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true,
    "SeedDevelopmentData": true
  },
  "Auth": {
    "Jwt": {
      "RequireHttpsMetadata": false
    },
    "Development": {
      "Enabled": true,
      "DefaultUserId": "0193a1c0-0000-7000-8000-000000000001"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "RateLimiting": {
    "TaskCreationPerMinute": 60
  },
  "PublicUrls": {
    "Dashboard": "http://localhost:5173"
  },
  "Ai": {
    "Provider": "Fake"
  },
  "GitHub": {
    "Mode": "Fake"
  },
  "Observability": {
    "ConsoleFormat": "text"
  }
}
