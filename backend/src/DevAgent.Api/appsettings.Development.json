{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System.Net.Http.HttpClient": "Warning",
        "Npgsql": "Warning"
      }
    }
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "Auth": {
    "RefreshCookie": {
      "Secure": false
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "RateLimiting": {
    "TaskCreationPerMinute": 60
  },
  "PublicUrls": {
    "Dashboard": "http://localhost:5173"
  },
  "Ai": {
    "Provider": "Fake"
  },
  "GitHub": {
    "Mode": "Fake"
  },
  "Observability": {
    "ConsoleFormat": "text"
  },
  "Bootstrap": {
    "SuperAdmin": {
      "Email": "admin@devagent.local"
    }
  }
}
